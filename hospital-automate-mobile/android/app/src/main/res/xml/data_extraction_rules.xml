<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ ignores allowBackup="false" for device-to-device transfer.
  These rules exclude every app data domain from both cloud backup and
  device transfer: tokens are bound to this device's Keystore, and nothing
  the app stores (session, chosen hospital, temporary scribe audio) may move
  to another phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
