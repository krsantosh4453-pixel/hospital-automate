# Production / staging environment for docker-compose.prod.yml (web, worker,
# beat, and Compose interpolation). Copy to .env.production, fill in every
# REQUIRED value, `chmod 600` it, keep it out of git, and always run Compose
# with `--env-file .env.production` (docs/STAGING_DEPLOYMENT.md).
# Production settings refuse to start without the REQUIRED values
# (backend/security_tests/test_settings_loading.py).
#
# Generate secrets as hex (openssl rand -hex 32): "$", "@", ":" and "/" break
# Compose interpolation or the database URL.

# ---- REQUIRED: Django -------------------------------------------------------
DJANGO_SECRET_KEY=            # 50+ random characters: openssl rand -hex 40
ALLOWED_HOSTS=hms.example.org # real host names only; '*' is refused
CORS_ALLOWED_ORIGINS=https://hms.example.org
ADMIN_URL=change-me-admin/    # non-default admin path

# ---- REQUIRED: public host name for nginx (server_name, HTTPS redirect) -----
DOMAIN_NAME=hms.example.org

# ---- REQUIRED: compose interpolation (also used by postgres/redis services) --
POSTGRES_USER=hms_user
POSTGRES_PASSWORD=            # openssl rand -hex 24
POSTGRES_DB=hms_prod
REDIS_PASSWORD=               # openssl rand -hex 24

# ---- Optional: host ports (all but nginx bind to 127.0.0.1 only) ------------
# POSTGRES_HOST_PORT=5432     # change if the host runs its own PostgreSQL
# BACKEND_HOST_PORT=8000
# HTTP_PORT=80
# HTTPS_PORT=443

# ---- REQUIRED: JWT (RS256). One line per key with \n escapes, e.g. ----------
#   awk 'BEGIN{ORS="\\n"}1' jwt_private.pem
# Start-up refuses keys that do not load or do not belong together.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=hospital-management-system
JWT_AUDIENCE=hms-api

# ---- REQUIRED: email (password reset notices, patient email OTP) ------------
EMAIL_HOST=smtp.example.org
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Hospital <noreply@hms.example.org>

# ---- REQUIRED: Google sign-in client id (settings refuse to start without it) -
GOOGLE_CLIENT_ID=

# ---- Twilio Verify (staff OTP, patient OTP, password reset) -----------------
# Required while STAFF_LOGIN_REQUIRE_OTP=True or PATIENT_OTP_DELIVERY=sms.
# Without Twilio: STAFF_LOGIN_REQUIRE_OTP=False and PATIENT_OTP_DELIVERY=off
# (staff sign in with a password; patients use e-mail OTP); OTP_PROVIDER then defaults to disabled.
OTP_PROVIDER=twilio
PATIENT_OTP_DELIVERY=sms
# SMS / WhatsApp reminders (same Twilio account). Leave empty to keep them off.
# Messaging Service with your DLT-registered sender (India); WhatsApp sender and
# an approved template for messages the hospital starts; public HTTPS callback URL.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=
TWILIO_STATUS_CALLBACK_URL=https://<your-domain>/api/notifications/twilio/status/
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_VERIFY_SERVICE_SID=
# Legacy SMS sender (optional)
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---- Staff sign-in policy ----------------------------------------------------
# True: password alone never issues a token; staff must complete SMS OTP.
STAFF_LOGIN_REQUIRE_OTP=True

# ---- Optional: AI scribe (no provider = AI features report "unavailable") ---
AI_SCRIBE_ENABLED=False
AI_SCRIBE_PROVIDER=openai
AI_SCRIBE_API_KEY=
# Any OpenAI-compatible /chat/completions host; the model must support JSON-schema output.
AI_SCRIBE_LLM_BASE_URL=https://api.openai.com/v1
AI_SCRIBE_MODEL=gpt-4o-mini
AI_SCRIBE_LLM_TIMEOUT_SECONDS=60
# Speech-to-text (consultation audio goes to this provider; whisper_local keeps it on-premises).
AI_SCRIBE_STT_PROVIDER=
AI_SCRIBE_STT_API_KEY=
AI_SCRIBE_STT_BASE_URL=https://api.openai.com/v1
AI_SCRIBE_STT_MODEL=whisper-1

# ---- Optional: interoperability ---------------------------------------------
# FHIR (/api/fhir/) and ABDM (/api/abdm/) are mounted but answer only when
# enabled; keep False until conformance and security review. HL7 is not mounted.
FHIR_ENABLED=False
HL7_ENABLED=False
HL7_IP_WHITELIST=
HL7_API_KEY=
ABDM_ENABLED=False
ABDM_BASE_URL=
ABDM_ABHA_BASE_URL=
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=

# ---- Optional: operations ----------------------------------------------------
# API schema / Swagger / ReDoc: False = platform admins (is_staff) only (R-11).
API_DOCS_PUBLIC=False
SENTRY_DSN=
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
AUDIT_LOG_RETENTION_DAYS=0
BACKUP_ENABLED=False
# REQUIRED by scripts/deploy/backup.sh, which refuses to write unencrypted backups.
# python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Keep a copy OUTSIDE the server: without it the backups cannot be restored.
BACKUP_ENCRYPTION_KEY=
# Reverse proxies in front of Django (nginx in docker-compose.prod.yml = 1);
# client addresses for rate limits are read through this many hops.
TRUSTED_PROXY_COUNT=1
GUNICORN_WORKERS=4
CELERY_WORKER_CONCURRENCY=4
