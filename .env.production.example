# Production environment for docker-compose.prod.yml (web, worker and beat).
# Copy to .env.production, fill in every REQUIRED value, keep it out of git,
# and prefer a secret manager over a file on disk where you can.
# backend/config/tests_production_settings.py checks this list stays complete.

# ---- REQUIRED: Django -------------------------------------------------------
DJANGO_SECRET_KEY=            # 50+ random characters
ALLOWED_HOSTS=hms.example.org
CORS_ALLOWED_ORIGINS=https://hms.example.org
ADMIN_URL=change-me-admin/    # non-default admin path

# ---- REQUIRED: compose interpolation (also used by postgres/redis services) --
POSTGRES_USER=hms_user
POSTGRES_PASSWORD=
POSTGRES_DB=hms_prod
REDIS_PASSWORD=

# ---- REQUIRED: JWT (RS256). PEM text with literal newlines or \n escapes ------
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=hospital-management-system
JWT_AUDIENCE=hms-api

# ---- REQUIRED: email (password reset notices, patient email OTP) ------------
EMAIL_HOST=smtp.example.org
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Hospital <noreply@hms.example.org>

# ---- REQUIRED: Google sign-in client id (settings refuse to start without it) -
GOOGLE_CLIENT_ID=

# ---- REQUIRED: Twilio Verify (staff OTP, patient OTP, password reset) -------
OTP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_VERIFY_SERVICE_SID=
# Legacy SMS sender (optional)
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---- Staff sign-in policy ----------------------------------------------------
# True: password alone never issues a token; staff must complete SMS OTP.
STAFF_LOGIN_REQUIRE_OTP=True

# ---- Optional: AI scribe (no provider = AI features report "unavailable") ---
AI_SCRIBE_ENABLED=False
AI_SCRIBE_PROVIDER=openai
AI_SCRIBE_API_KEY=
AI_SCRIBE_MODEL=gpt-4

# ---- Optional: interoperability (routes are NOT mounted; leave False) -------
FHIR_ENABLED=False
HL7_ENABLED=False
HL7_IP_WHITELIST=
HL7_API_KEY=
ABDM_ENABLED=False
ABDM_BASE_URL=
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=

# ---- Optional: operations ----------------------------------------------------
SENTRY_DSN=
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
AUDIT_LOG_RETENTION_DAYS=0
BACKUP_ENABLED=False
BACKUP_ENCRYPTION_KEY=
GUNICORN_WORKERS=4
CELERY_WORKER_CONCURRENCY=4
