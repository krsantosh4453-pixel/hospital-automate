# Hospital Management System - Environment Variables Template
# Copy this file to .env and fill in the values
# NEVER commit the actual .env file with real secrets!

# ============================================================
# Django Core Settings
# ============================================================

# Environment: development, testing, production
DJANGO_ENV=development

# Django Secret Key (generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
DJANGO_SECRET_KEY=django-insecure-change-this-in-production

# JWT Secret Key (optional, separate from Django secret for token signing)

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Admin URL (obfuscate in production)
ADMIN_URL=admin/

# ============================================================
# Database (PostgreSQL)
# ============================================================

# Database URL format: postgres://user:password@host:port/dbname
# For development with Docker: postgres://hms_user:hms_password@postgres:5432/hms_dev
# For production: postgres://user:password@host:5432/dbname
DATABASE_URL=postgres://hms_user:hms_password@localhost:5432/hms_dev

# Individual components (alternative to DATABASE_URL)
# POSTGRES_DB=hms_dev
# POSTGRES_USER=hms_user
# POSTGRES_PASSWORD=hms_password
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# ============================================================
# Redis
# ============================================================

# Redis URL format: redis://[:password@]host:port/db
# For development with Docker: redis://redis:6379/0
# For production: redis://:password@host:6379/0
REDIS_URL=redis://localhost:6379/0

# Redis password (if using authenticated Redis)
REDIS_PASSWORD=

# ============================================================
# Celery
# ============================================================

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Worker concurrency
CELERY_WORKER_CONCURRENCY=4

# ============================================================
# CORS & CSRF
# ============================================================

# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# CSRF trusted origins (same as CORS for production)
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ============================================================
# HTTPS/SSL (Production)
# ============================================================

SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ============================================================
# Email (SMTP)
# ============================================================

# Development sends real email only when EMAIL_HOST_USER and EMAIL_HOST_PASSWORD
# are set; otherwise OTP emails are printed to the runserver console.
# Gmail needs an App Password (Google Account > Security > App passwords).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Hospital Management System <noreply@yourdomain.com>
# Seconds before an unreachable SMTP server fails the send.
EMAIL_TIMEOUT=10

# ============================================================
# Google OAuth
# ============================================================

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================================================
# AI Medical Scribe
# ============================================================

AI_SCRIBE_ENABLED=True
# Development only: canned STT/LLM output when no provider key is set.
# Never allowed in production settings.
AI_SCRIBE_ALLOW_MOCK_PROVIDERS=True
AI_SCRIBE_PROVIDER=openai
AI_SCRIBE_API_KEY=your-openai-api-key
AI_SCRIBE_MODEL=gpt-4
AI_SCRIBE_MAX_TOKENS=4000
AI_SCRIBE_TEMPERATURE=0.1
# Speech-to-text (Hindi / English / Hinglish). Leave the key empty to keep the
# development mock. OpenAI: keep the defaults below. Groq (free tier):
#   AI_SCRIBE_STT_BASE_URL=https://api.groq.com/openai/v1
#   AI_SCRIBE_STT_MODEL=whisper-large-v3
AI_SCRIBE_STT_API_KEY=
AI_SCRIBE_STT_BASE_URL=https://api.openai.com/v1
AI_SCRIBE_STT_MODEL=whisper-1
AI_SCRIBE_STT_PROVIDER=whisper_api

# ============================================================
# FHIR Interoperability
# ============================================================

FHIR_ENABLED=False
FHIR_BASE_URL=https://yourdomain.com/api/fhir/
FHIR_VERSION=R4

# ============================================================
# HL7 Messaging
# ============================================================

HL7_ENABLED=False
HL7_LISTEN_PORT=2575
HL7_MSH_SENDING_APPLICATION=HMS
HL7_MSH_SENDING_FACILITY=HOSPITAL

# ============================================================
# ABDM/ABHA Integration
# ============================================================

# Sandbox credentials come from https://sandbox.abdm.gov.in after registration.
# Built: verify an existing ABHA by OTP and link it to a patient.
ABDM_ENABLED=False
ABDM_BASE_URL=https://dev.abdm.gov.in
ABDM_ABHA_BASE_URL=https://abhasbx.abdm.gov.in/abha/api
ABDM_CM_ID=sbx
ABDM_CLIENT_ID=your-abdm-client-id
ABDM_CLIENT_SECRET=your-abdm-client-secret

# ============================================================
# Notifications (SMS/WhatsApp/Push)
# ============================================================

SMS_PROVIDER=twilio
# True: staff must complete SMS OTP after the password (always True in production by default).
STAFF_LOGIN_REQUIRE_OTP=False

# Twilio Verify v2 (preferred for OTP). Needs TWILIO_ACCOUNT_SID and
# TWILIO_VERIFY_SERVICE_SID plus either API key + secret or TWILIO_AUTH_TOKEN.
# Patient SMS is only sent when PATIENT_OTP_DELIVERY=sms; "console" prints the code
# to the runserver log instead. Twilio trial accounts can only text verified numbers.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_API_KEY=your-twilio-api-key
TWILIO_API_SECRET=your-twilio-api-secret
TWILIO_VERIFY_SERVICE_SID=your-twilio-verify-service-sid

# Legacy Twilio SMS (fallback)
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

WHATSAPP_PROVIDER=twilio
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token

PUSH_NOTIFICATION_PROVIDER=firebase
FIREBASE_CREDENTIALS_PATH=/path/to/firebase-credentials.json

# ============================================================
# Cloud Storage (AWS S3 example)
# ============================================================

# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_CUSTOM_DOMAIN=your-cdn-domain.com

# ============================================================
# Monitoring & Error Tracking
# ============================================================

# Sentry
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Prometheus (if using django-prometheus)
# PROMETHEUS_ENABLED=True

# ============================================================
# Backup
# ============================================================

# Audit rows older than this many days are purged daily; 0 keeps them forever.
AUDIT_LOG_RETENTION_DAYS=0
BACKUP_ENABLED=True
BACKUP_STORAGE_PATH=/backups
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_KEY=your-backup-encryption-key

# ============================================================
# Frontend (Vite)
# ============================================================

# '/api' uses the Vite dev proxy (VITE_PROXY_TARGET, default http://127.0.0.1:8000).
VITE_API_BASE_URL=/api
# Development-only switches; production builds ignore both and always require login.
# VITE_DEV_AUTH_BYPASS=true signs in a fake Admin when no session exists (set false to test real login).
VITE_DEV_AUTH_BYPASS=true
# VITE_AUTH_REQUIRED=false lets the Home page load without a session.
VITE_AUTH_REQUIRED=true

# ============================================================
# Domain Name (for nginx config)
# ============================================================

DOMAIN_NAME=yourdomain.com

# Temporary shared development sign-in (DEBUG only; never in production).
# One mobile number or email + one password opens the seed_demo account of any role.
DEV_LOGIN_ENABLED=false
DEV_LOGIN_MOBILE=
DEV_LOGIN_EMAIL=
DEV_LOGIN_PASSWORD=
